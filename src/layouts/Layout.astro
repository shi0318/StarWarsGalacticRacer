---
// Shared metadata and navigation. No advertising or analytics tags are loaded.
import '../styles/global.css';
import { SITE } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientParticles from '../components/AmbientParticles.astro';
import Schema from '../components/Schema.astro';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  // SEO 三要素（方案 5.3）
  title: string; // <title>，60 字符以内
  description: string; // meta description，150-160 字符
  // Schema 类型
  schemaType?: 'home' | 'article' | 'news' | 'collection' | 'page';
  breadcrumb?: Crumb[];
  datePublished?: string;
  dateModified?: string;
  // canonical 覆盖（默认取当前路径）
  canonical?: string;
  // 是否允许索引（草稿页可设 false）
  noindex?: boolean;
  // 社交分享图（相对路径，默认站点通用图）
  ogImage?: string;
}

const {
  title,
  description,
  schemaType = 'page',
  breadcrumb = [],
  datePublished,
  dateModified,
  canonical,
  noindex = false,
  ogImage = '/og-default.jpg',
} = Astro.props;

// 当前页面路径（含尾斜杠，与 trailingSlash: 'always' 一致）
const path = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(path, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

// Previous analytics configuration, intentionally inactive. Restore the tag only
// after implementing a real consent mechanism and updating the privacy policy.
// This identifier is a public measurement configuration, not an AdSense ID.
const pausedGA4 = { measurementId: 'G-NXF7FV9GKL', enabled: false } as const;

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / 社交分享 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content="#05060d" />

    <!-- JSON-LD 结构化数据（方案第三章 Schema 矩阵） -->
    <Schema
      type={schemaType}
      path={path}
      title={title}
      description={description}
      breadcrumb={breadcrumb}
      datePublished={datePublished}
      dateModified={dateModified}
    />

  </head>
  <body class="flex min-h-screen flex-col">
    <AmbientParticles />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-plasma focus:px-4 focus:py-2 focus:text-void-950"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
