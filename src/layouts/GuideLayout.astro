---
// 攻略文章布局 —— 内容集合 guides 的每篇 .md 都用它渲染。
// 统一输出：面包屑 →（仅未发售文）提示 → H1 → 正文。来源表只在 frontmatter 写了 sources 时出现。
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PreReleaseNotice from '../components/PreReleaseNotice.astro';
import SourceTable from '../components/SourceTable.astro';
import { SITE } from '../data/site';
import type { ConfidenceStatus, SourceRef } from '../data/sources';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string; // <title>
  heading?: string; // H1（默认取 title）
  description: string;
  category: 'guide' | 'characters' | 'vehicles' | 'tracks' | 'unlocks' | 'cheats' | 'tips' | 'news';
  status: ConfidenceStatus;
  sources?: SourceRef[];
  preRelease?: boolean;
  updatedAt: string;
  datePublished?: string;
}

const {
  title,
  heading,
  description,
  category,
  status,
  sources = [],
  preRelease = false,
  updatedAt,
  datePublished,
} = Astro.props;

// 已知路径段的友好显示名（未列出的段用标题化的 slug）
const SEGMENT_LABEL: Record<string, string> = {
  guide: 'Guide',
  characters: 'Characters',
  vehicles: 'Vehicles',
  tracks: 'Tracks',
  unlocks: 'Unlocks',
  cheats: 'Cheats',
  tips: 'Tips',
  news: 'News',
  'best-build': 'Best Build',
  'credits-farming': 'Credits Farming',
  'fastest-vehicle': 'Fastest Vehicle',
};

const h1 = heading ?? title;
const titleize = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// 面包屑从真实 URL 段推导，保证与 URL 层级严格一致（方案 3.2）。
const segments = Astro.url.pathname.split('/').filter(Boolean);
const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  ...segments.map((seg, i) => {
    const url = '/' + segments.slice(0, i + 1).join('/') + '/';
    const name =
      i === segments.length - 1 ? h1 : (SEGMENT_LABEL[seg] ?? titleize(seg));
    return { name, url };
  }),
];

// news 分类用 NewsArticle，其余用 Article
const schemaType = category === 'news' ? 'news' : 'article';

// Retain the legacy indexing categories during the content consolidation.
// These internal values do not certify developer approval or hands-on testing.
const INDEXABLE_STATUS: ConfidenceStatus[] = ['official', 'beta'];
const noindex = !INDEXABLE_STATUS.includes(status) || Astro.url.pathname === '/landspeeder-guide/';
---

<Layout
  title={title}
  description={description}
  schemaType={schemaType}
  breadcrumb={crumbs}
  datePublished={datePublished}
  dateModified={updatedAt}
  noindex={noindex}
  canonical={Astro.url.pathname === '/landspeeder-guide/' ? 'https://swgalacticracer.wiki/vehicles/landspeeders/' : undefined}
>
  <article class="mx-auto max-w-3xl">
    <Breadcrumb items={crumbs} />

    {preRelease && <PreReleaseNotice />}

    <header class="mt-4 border-b border-void-800 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-void-100 md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-void-400">{description}</p>
      <p class="mt-4 text-sm text-void-500">
        By <a href="/editorial/" class="underline hover:text-plasma">{SITE.name} editorial team</a>
        <span aria-hidden="true"> · </span>
        Last updated <time datetime={updatedAt}>{updatedAt}</time>
        {datePublished && <> · Published <time datetime={datePublished}>{datePublished}</time></>}
      </p>
    </header>

    <div class="guide-copy prose-body mt-8 space-y-4 text-void-200">
      <slot />
    </div>

    {sources.length > 0 && <SourceTable sources={sources} />}
  </article>
</Layout>

<style>
  .guide-copy :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 650;
    line-height: 1.35;
    color: var(--color-void-100);
  }
  .guide-copy :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-void-100);
  }
  .guide-copy :global(a) {
    color: var(--color-plasma);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    overflow-wrap: anywhere;
  }
  .guide-copy :global(ul), .guide-copy :global(ol) { padding-left: 1.5rem; }
  .guide-copy :global(ul) { list-style-type: disc; }
  .guide-copy :global(ol) { list-style-type: decimal; }
  .guide-copy :global(li + li) { margin-top: 0.4rem; }
  .guide-copy :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .guide-copy :global(th), .guide-copy :global(td) {
    min-width: 8rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-void-700);
    text-align: left;
    vertical-align: top;
  }
  .guide-copy :global(th) {
    color: var(--color-void-100);
    background: var(--color-void-900);
    font-weight: 600;
  }
  .guide-copy :global(pre) { overflow-x: auto; padding: 0.75rem; }
  .guide-copy :global(blockquote) {
    padding-left: 1rem;
    border-left: 3px solid var(--color-void-700);
    color: var(--color-void-300);
  }
</style>
