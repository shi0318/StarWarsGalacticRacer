---
// 攻略聚合页 — CollectionPage schema（方案 3.1：列表页不标 Article）。
// 卡片式列表：缩略图 + 分类标签 + 日期 + 摘要。
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuideCard from '../../components/GuideCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { SITE_IMAGES } from '../../data/images';

const title = 'Star Wars Galactic Racer Guide — Racers, Vehicles & Tracks';
const description =
  'Star Wars Galactic Racer guides for the launched game: racers, vehicle classes, planet circuits, campaign builds, and the multiplayer tour.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Guide', url: '/guide/' },
];

const CATEGORY_LABEL: Record<string, string> = {
  guide: 'Overview',
  characters: 'Characters',
  vehicles: 'Vehicles',
  tracks: 'Tracks',
  unlocks: 'Unlocks',
  tips: 'Tips',
  news: 'News',
};

// fallback covers if a guide has no frontmatter cover
const FALLBACK_COVER: Record<string, string> = {
  guide: SITE_IMAGES.heroRace.src,
  characters: SITE_IMAGES.charactersArt.src,
  vehicles: SITE_IMAGES.vehiclesArt.src,
  tracks: SITE_IMAGES.tracksArt.src,
  unlocks: SITE_IMAGES.unlocksArt.src,
  tips: SITE_IMAGES.tipsArt.src,
  news: SITE_IMAGES.cityCircuit.src,
};

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt) || a.id.localeCompare(b.id),
);
const PAGE_SIZE = 9;
const currentPage = 1;
const totalPages = Math.ceil(guides.length / PAGE_SIZE);
const visibleGuides = guides.slice(0, PAGE_SIZE);

function coverOf(g: (typeof guides)[number]) {
  return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? SITE_IMAGES.heroRace.src;
}

function labelOf(cat: string) {
  return CATEGORY_LABEL[cat] ?? cat;
}
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-plasma">Start here</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-void-100 md:text-5xl">
      Latest racing guides
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-void-400">
      Character, vehicle, and planet pages live in their own sections. Start with the four
      questions people ask after launch, then the longer reads.
    </p>
  </header>

  <section class="mb-10">
    <h2 class="mb-4 text-xl font-semibold text-void-100">After launch</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      <li><a class="text-plasma hover:underline" href="/achievements/">Achievements and trophies</a> — grouped by system, not by a fake time sheet.</li>
      <li><a class="text-plasma hover:underline" href="/how-long-to-beat/">How long to beat</a> — campaign, retries, and arcade are different clocks.</li>
      <li><a class="text-plasma hover:underline" href="/is-it-worth-it/">Worth buying?</a> — the tour, not a ranked ladder.</li>
      <li><a class="text-plasma hover:underline" href="/platforms/">Platforms</a> — PC, PS5, Xbox Series. Not Switch 2. Not Game Pass.</li>
    </ul>
  </section>

  <section class="latest-guides" aria-label="Latest guides">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-plasma">Latest guides first</p>
    <h2 class="mt-2 mb-5 text-2xl font-bold tracking-tight text-void-100 md:text-3xl">New and recently updated</h2>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {visibleGuides.map((g) => <GuideCard href={`/${g.id}/`} title={g.data.heading ?? g.data.title} description={g.data.description} cover={coverOf(g)} label={labelOf(g.data.category)} verified={g.data.updatedAt} status={g.data.status} />)}
    </ul>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/guide/" />
  </section>
</Layout>
