---
// 首页 —— WebSite + Organization Schema（方案 3.1）
// 结构：Hero → 差异化说明 → 图片 → 分类 → 入门 → 发售信息。
import Layout from '../layouts/Layout.astro';
import Countdown from '../components/Countdown.astro';
import { SITE, isReleased } from '../data/site';
import { RACERS } from '../data/characters';
import { VEHICLES } from '../data/vehicles';
import { TRACKS } from '../data/tracks';
import MediaFigure from '../components/MediaFigure.astro';
import { SITE_IMAGES } from '../data/images';

const released = isReleased();

// 首页 TDK（方案 5.3 核心页面 TDK）
const title = 'Star Wars Galactic Racer Wiki & Guide';
const description =
  'Star Wars Galactic Racer is out. Racers, vehicle classes, planet circuits, campaign builds, and multiplayer tours — a guide for the game you can play now.';

// 内容分类入口
const categories = [
  {
    href: '/characters/',
    title: 'Characters',
    desc: 'Every racer, their faction, signature traits, and how to unlock them.',
    count: RACERS.length,
    countLabel: 'racers tracked',
  },
  {
    href: '/vehicles/',
    title: 'Vehicles',
    desc: 'Landspeeders, speeder bikes, skim speeders, and podracers — classes, stats, and handling notes.',
    count: VEHICLES.length,
    countLabel: 'vehicles tracked',
  },
  {
    href: '/tracks/',
    title: 'Tracks',
    desc: 'Circuit layouts, planet hazards, and difficulty for every course.',
    count: TRACKS.length,
    countLabel: 'tracks tracked',
  },
  {
    href: '/unlocks/',
    title: 'Unlocks',
    desc: 'How to unlock racers, vehicles, and cosmetics — plus progression tips.',
    count: null,
    countLabel: '',
  },
];

// 入门指南卡片
const startHere = [
  {
    href: '/achievements/',
    title: 'Achievements',
    desc: 'Campaign, arcade, pods, and the systems trophy lists name.',
  },
  {
    href: '/how-long-to-beat/',
    title: 'How long to beat',
    desc: 'A tour, a retry, and an arcade gold are three different clocks.',
  },
  {
    href: '/is-it-worth-it/',
    title: 'Worth buying?',
    desc: 'Buy the combat tour. Do not buy a ranked ladder that is not there.',
  },
  {
    href: '/platforms/',
    title: 'Platforms',
    desc: 'PC, PS5, and Xbox Series. Not Switch 2. Not Game Pass.',
  },
];

const moreStart = [
  {
    href: '/game-overview/',
    title: 'What you can play',
    desc: 'Campaign runs, arcade, pods, and the six-race multiplayer tour.',
  },
  {
    href: '/tips/campaign-builds/',
    title: 'Build order',
    desc: 'Resilience first, then afterburner. Ramjet only after the line is learned.',
  },
  {
    href: '/tracks/',
    title: 'Planet circuits',
    desc: 'Jakku, Ando Prime, Crait, Sentinel One, Lantaana, and Derven Acos.',
  },
  {
    href: '/vehicles/',
    title: 'Vehicle classes',
    desc: 'Tanks, Kinetic Burst, Knife Edge, and why pods race alone.',
  },
];

const faqs = [
  {
    q: 'Is Star Wars Galactic Racer any good?',
    a: 'Buy it if you want a combat tour where a shunt is legal and a wreck ends the run. Skip it if you want a long ranked career, a friend lobby, or a 20-course cup. Standard edition is $59.99 on Steam.',
  },
  {
    q: 'Is it a roguelike?',
    a: 'No. It is runs-based. You pick events and cannot unpick them. Crash out too often and the tour ends, with only some perks carrying over. That is not a deck-building roguelike.',
  },
  {
    q: 'How long does it take to beat?',
    a: 'A first tour is an evening if you do not wreck out, and a weekend if you restart the same fragile bike. Arcade golds and the online tour are separate clocks, not part of that number.',
  },
  {
    q: 'Does it have a campaign?',
    a: 'Yes. You play Shade, Hibi fits the speeder, and the tour climbs toward champion Kestar Bool. Arcade and online exist beside that campaign.',
  },
  {
    q: 'Is it on Switch 2 or Game Pass?',
    a: 'No. It launched on PC, PlayStation 5, and Xbox Series X|S. It is not a Switch 2 game and it did not launch on Game Pass.',
  },
];
---

<Layout title={title} description={description} schemaType="home">
  <!-- Hero -->
  <section class="relative overflow-hidden rounded-2xl border border-void-800">
    <div class="absolute inset-0">
      <img
        src={SITE_IMAGES.heroBanner.src}
        alt={SITE_IMAGES.heroBanner.alt}
        width={SITE_IMAGES.heroBanner.width}
        height={SITE_IMAGES.heroBanner.height}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-void-950/95 via-void-950/80 to-void-950/55"></div>
    </div>
    <div class="relative px-6 py-14 md:px-10 md:py-20">
      <div class="mx-auto max-w-3xl text-center">
        {
          released ? (
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-plasma/30 bg-plasma/10 px-3 py-1 text-xs font-medium text-plasma">
              Out now · Launched October 6, 2026
            </p>
            <p class="mb-4 text-xs text-void-400">
              Last verified <time datetime="2026-10-08">October 8, 2026</time>
            </p>
          ) : (
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-plasma/30 bg-plasma/10 px-3 py-1 text-xs font-medium text-plasma">
              Pre-release Guide · Launch October 6, 2026
            </p>
          )
        }
        <h1 class="text-4xl font-bold tracking-tight text-void-100 md:text-5xl">
          Star Wars Galactic Racer: <span class="text-plasma">Racers, Vehicles &amp; Track Guide</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-void-300">
          Shade, the four repulsorcraft classes, and the planets the Galactic League
          actually races. Written for the game that launched on October 6, 2026.
        </p>

        {!released && <div class="mt-8"><Countdown /></div>}

        <nav class="mt-6 flex flex-wrap justify-center gap-2" aria-label="Start here">
          {
            startHere.map((item) => (
              <a
                href={item.href}
                class="rounded-full border border-plasma/40 bg-void-950/70 px-3 py-1.5 text-sm text-void-100 hover:border-plasma hover:text-plasma"
              >
                {item.title}
              </a>
            ))
          }
        </nav>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/guide/"
            class="rounded-lg bg-plasma px-5 py-2.5 font-medium text-void-950 transition-colors hover:bg-plasma-deep"
          >
            Read the guide
          </a>
          <a
            href="/characters/"
            class="rounded-lg border border-void-600 px-5 py-2.5 font-medium text-void-200 transition-colors hover:border-void-500 hover:bg-void-800"
          >
            Browse racers
          </a>
          <a
            href="/tracks/"
            class="rounded-lg border border-void-600 px-5 py-2.5 font-medium text-void-200 transition-colors hover:border-void-500 hover:bg-void-800"
          >
            Track list
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 官方设定：What is Star Wars Galactic Racer?（首段直接给答案，利于精选摘要） -->
  <section class="mt-12">
    <div class="rounded-xl border border-void-800 bg-void-900/40 p-6 md:p-8">
      <h2 class="text-xl font-semibold text-void-100">What is Star Wars Galactic Racer?</h2>
      <p class="mt-3 max-w-3xl text-void-300">
        <strong class="text-void-100">Star Wars Galactic Racer</strong> is a runs-based combat
        racing game from {SITE.developer}, published by {SITE.publisher}. It launched October 6, 2026 on PC, PlayStation 5, and
        Xbox Series X|S. You play as <strong class="text-void-100">Shade</strong>, a lone racer
        chasing revenge through the underground <strong class="text-void-100">Galactic
        League</strong> of the Outer Rim.
      </p>
      <p class="mt-3 max-w-3xl text-void-400">
        This is a combat racer — you don't just outdrive rivals, you slam, shunt, and take them
        down. You pilot different classes of repulsorcraft — landspeeders, speeder bikes, skim
        speeders, and podracers — each with distinct physics and playstyles, and build your ride
        between story-driven campaign runs and strategic PvP grudge matches. As the official
        pitch puts it: <em class="text-void-200">"No Force. No prophecy. Just skill, strategy,
        and the will to rise."</em>
      </p>
      <p class="mt-4 text-sm text-void-500">
        Standard edition is {SITE.price} on Steam. Pods race on their own grid. The three speeder classes share one.
      </p>
    </div>
  </section>

  <section class="mt-12" id="faq">
    <h2 class="text-2xl font-bold tracking-tight text-void-100">Common questions</h2>
    <div class="mt-5 space-y-3">
      {
        faqs.map((item) => (
          <details class="rounded-xl border border-void-800 bg-void-900/40 px-5 py-4" open>
            <summary class="cursor-pointer text-base font-semibold text-void-100">{item.q}</summary>
            <p class="mt-2 max-w-3xl text-void-300">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Featured imagery -->
  <section class="mt-12">
    <h2 class="mb-5 text-2xl font-bold tracking-tight text-void-100">Featured imagery</h2>
    <p class="mb-5 max-w-3xl text-void-400">
      In-game shots of the circuits, pods, and paddock you will actually race.
    </p>
    <div class="grid gap-4 md:grid-cols-2">
      <MediaFigure
        src={SITE_IMAGES.heroRace.src}
        alt={SITE_IMAGES.heroRace.alt}
        width={SITE_IMAGES.heroRace.width}
        height={SITE_IMAGES.heroRace.height}
        credit={SITE_IMAGES.heroRace.credit}
      />
      <MediaFigure
        src={SITE_IMAGES.vehiclesArt.src}
        alt={SITE_IMAGES.vehiclesArt.alt}
        width={SITE_IMAGES.vehiclesArt.width}
        height={SITE_IMAGES.vehiclesArt.height}
        credit={SITE_IMAGES.vehiclesArt.credit}
      />
      <MediaFigure
        src={SITE_IMAGES.cityCircuit.src}
        alt={SITE_IMAGES.cityCircuit.alt}
        width={SITE_IMAGES.cityCircuit.width}
        height={SITE_IMAGES.cityCircuit.height}
        credit={SITE_IMAGES.cityCircuit.credit}
      />
      <MediaFigure
        src={SITE_IMAGES.lavaCircuit.src}
        alt={SITE_IMAGES.lavaCircuit.alt}
        width={SITE_IMAGES.lavaCircuit.width}
        height={SITE_IMAGES.lavaCircuit.height}
        credit={SITE_IMAGES.lavaCircuit.credit}
      />
    </div>
  </section>

  <!-- 分类导航 -->
  <section class="mt-12">
    <h2 class="mb-5 text-2xl font-bold tracking-tight text-void-100">Explore the wiki</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((c) => (
          <a
            href={c.href}
            class="group flex flex-col rounded-xl border border-void-800 bg-void-900/40 p-5 transition-colors hover:border-plasma/40 hover:bg-void-900"
          >
            <span class="text-lg font-semibold text-void-100 group-hover:text-plasma">
              {c.title}
            </span>
            <span class="mt-1 flex-1 text-sm text-void-400">{c.desc}</span>
            {c.count !== null && (
              <span class="mt-3 text-xs text-void-500">
                {c.count} {c.countLabel}
              </span>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- 板块详解：Tracks / Vehicles / Characters（扩充首页内容深度） -->
  <section class="mt-12 space-y-6">
    <h2 class="text-2xl font-bold tracking-tight text-void-100">What each section covers</h2>

    <div class="rounded-xl border border-void-800 bg-void-900/40 p-6 md:p-8">
      <h3 class="text-lg font-semibold text-void-100">Tracks: planets, not a numbered cup</h3>
      <p class="mt-3 max-w-3xl text-void-300">
        The League hops planets. Jakku is wreckage and dust. Ando Prime freezes you unless you
        hit the heat tunnels. Crait blinds you for drafting. Sentinel One is acid off the racing
        line. Lantaana is lava heat. Derven Acos is the custom arena the tour and the multiplayer
        showdown both point at.
      </p>
      <p class="mt-3 max-w-3xl text-void-400">
        There is still no useful minimap, so the first pass on each planet is reconnaissance.
        The <a href="/tracks/" class="text-plasma hover:underline">track list</a> covers the hazard
        that actually ends the run, not a fake corner count.
      </p>
    </div>

    <div class="rounded-xl border border-void-800 bg-void-900/40 p-6 md:p-8">
      <h3 class="text-lg font-semibold text-void-100">Vehicles: four confirmed repulsorcraft classes</h3>
      <p class="mt-3 max-w-3xl text-void-300">
        The Steam listing confirms you pilot four distinct classes of repulsorcraft:
        <strong class="text-void-100">landspeeders</strong>,
        <strong class="text-void-100">speeder bikes</strong>,
        <strong class="text-void-100">skim speeders</strong>, and
        <strong class="text-void-100">podracers</strong> — each with its own physics and playstyle,
        in the developer's own words.
      </p>
      <p class="mt-3 max-w-3xl text-void-400">
        Landspeeders are the tanks. Speeder bikes are fast, fragile, and live on Kinetic Burst.
        Skim speeders sit between them and ask you to hold a Knife Edge. Podracers do not share
        that grid — they are faster and larger, so they race alone. Two boosts sit on top of the
        class: afterburner, which you can tap, and ramjet, which you must hold and which cooks
        the craft if you do not lift. The
        <a href="/vehicles/" class="text-plasma hover:underline">vehicle pages</a> cover each class
        and the three Deluxe Kor Sarun hulls.
      </p>
    </div>

    <div class="rounded-xl border border-void-800 bg-void-900/40 p-6 md:p-8">
      <h3 class="text-lg font-semibold text-void-100">Characters: Shade against the Bool family</h3>
      <p class="mt-3 max-w-3xl text-void-300">
        You play <strong class="text-void-100">Shade</strong>. <strong class="text-void-100">Hibi</strong>
        fits the speeder between events. <strong class="text-void-100">Darius Pax</strong> founded
        the League. <strong class="text-void-100">Kestar Bool</strong> took it. <strong class="text-void-100">Sebulba</strong>
        is back on the pod grid, and he will not wave a new pilot at the champion without the practice.
      </p>
      <p class="mt-3 max-w-3xl text-void-400">
        The pitch is still <em class="text-void-200">"No Force. No prophecy. Just skill, strategy,
        and the will to rise."</em> The
        <a href="/characters/" class="text-plasma hover:underline">character pages</a> cover who you
        can race as, who only shows up in the paddock, and who is a story target rather than a garage unlock.
      </p>
    </div>
  </section>

  <!-- 入门指南 -->
  <section class="mt-12">
    <h2 class="mb-5 text-2xl font-bold tracking-tight text-void-100">Where to begin</h2>
    <p class="mb-5 max-w-3xl text-void-400">
      If you only open one race page, start with
      <a href="/tracks/sentinel-one/" class="text-plasma hover:underline">Sentinel One</a>.
      The acid pools are where an unprepared tour actually ends.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        moreStart.map((s) => (
          <a
            href={s.href}
            class="group rounded-xl border border-void-800 bg-void-900/40 p-5 transition-colors hover:border-plasma/40 hover:bg-void-900"
          >
            <h3 class="text-base font-semibold text-void-100 group-hover:text-plasma">
              {s.title}
            </h3>
            <p class="mt-1 text-sm text-void-400">{s.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 发售信息 -->
  <section class="mt-12 rounded-xl border border-void-800 bg-void-900/40 p-6 md:p-8">
    <h2 class="text-xl font-semibold text-void-100">Release information</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-3">
      <div>
        <dt class="text-xs uppercase tracking-wide text-void-500">Release date</dt>
        <dd class="mt-1 text-void-200">October 6, 2026</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-void-500">Developer</dt>
        <dd class="mt-1 text-void-200">{SITE.developer}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-void-500">Publisher</dt>
        <dd class="mt-1 text-void-200">{SITE.publisher}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-void-500">Genre</dt>
        <dd class="mt-1 text-void-200">Combat Racing (runs-based)</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-void-500">Platforms</dt>
        <dd class="mt-1 text-void-200">{SITE.platforms.join(', ')}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-void-500">Franchise</dt>
        <dd class="mt-1 text-void-200">{SITE.franchise}</dd>
      </div>
    </dl>
  </section>
</Layout>
