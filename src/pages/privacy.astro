---
// 隐私政策 —— AdSense 审核硬性要求（说明 Cookie、广告、分析数据的使用）。
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';

const title = 'Privacy Policy — Star Wars Galactic Racer Wiki';
const description =
  'How Star Wars Galactic Racer Wiki handles cookies, analytics, and advertising data. A plain-language privacy policy for our independent fan site.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy/' },
];

const updated = '2026-07-24';
---

<Layout title={title} description={description} schemaType="article" breadcrumb={crumbs}>
  <article class="mx-auto max-w-3xl">
    <Breadcrumb items={crumbs} />

    <h1 class="text-3xl font-bold tracking-tight text-void-100 md:text-4xl">Privacy Policy</h1>
    <p class="mt-3 text-lg text-void-400">
      What we collect, why, and the choices you have. Last updated {updated}.
    </p>

    <div class="prose-body mt-8 space-y-6 text-void-200">
      <section>
        <h2 class="text-xl font-semibold text-void-100">Who we are</h2>
        <p class="mt-2">
          {SITE.name} is an independent, fan-made resource. You can reach us at
          <a href={`mailto:${SITE.contactEmail}`} class="text-plasma underline underline-offset-2">
            {SITE.contactEmail}
          </a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-void-100">Analytics</h2>
        <p class="mt-2">
          We may use Google Analytics to understand which guides are useful, in aggregate. This
          uses cookies to record anonymised data such as pages viewed, approximate region, and
          device type. We do not use it to identify you personally.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-void-100">Advertising</h2>
        <p class="mt-2">
          This site may display ads served by Google AdSense and its partners. These third
          parties may use cookies to serve ads based on your prior visits to this and other
          websites. Google's use of advertising cookies enables it and its partners to serve
          ads based on your visits. You can opt out of personalised advertising by visiting
          <a
            href="https://www.google.com/settings/ads"
            rel="nofollow noopener"
            target="_blank"
            class="text-plasma underline underline-offset-2"
          >
            Google Ads Settings
          </a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-void-100">Cookies</h2>
        <p class="mt-2">
          Cookies are small text files stored by your browser. You can block or delete cookies
          in your browser settings. Some features may not work as expected if you disable them,
          but you can always read our guides.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-void-100">Your choices</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>Adjust or disable cookies in your browser settings.</li>
          <li>Opt out of personalised ads via Google Ads Settings.</li>
          <li>Contact us to ask what data relates to you, or to raise a concern.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-void-100">Changes to this policy</h2>
        <p class="mt-2">
          We may update this policy as the site grows or as advertising and analytics providers
          change. The "last updated" date above always reflects the current version.
        </p>
      </section>
    </div>
  </article>
</Layout>
