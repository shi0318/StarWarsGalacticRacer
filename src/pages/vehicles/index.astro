---
// Vehicles 分类聚合页（CollectionPage）—— 方案 5.1
import Layout from '../../layouts/Layout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { SITE_IMAGES } from '../../data/images';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { VEHICLES } from '../../data/vehicles';

const title = 'All Vehicles in Star Wars Galactic Racer — Podracers & Speeders';
const description =
  'Landspeeders, speeder bikes, skim speeders, and podracers in Star Wars Galactic Racer, plus the three Kor Sarun deluxe hulls. Classes, abilities, and where each one wins.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Vehicles', url: '/vehicles/' },
];
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <div class="mb-8 mt-4">
    <MediaFigure
      src={SITE_IMAGES.vehiclesArt.src}
      alt={SITE_IMAGES.vehiclesArt.alt}
      width={SITE_IMAGES.vehiclesArt.width}
      height={SITE_IMAGES.vehiclesArt.height}
      credit={SITE_IMAGES.vehiclesArt.credit}
    />
  </div>

  <header class="mt-4 max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-void-100 md:text-4xl">
      Star Wars Galactic Racer Vehicles
    </h1>
    <p class="mt-3 text-lg text-void-400">
      Three speeder classes share a grid. Podracers do not. The Kor Sarun hulls are Deluxe
      bodies on those same classes, not a fifth physics model.
    </p>
  </header>

  <div class="mt-8 overflow-x-auto rounded-lg border border-void-800">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-void-700 bg-void-900/60 text-left text-void-400">
          <th class="px-4 py-3 font-medium">Vehicle</th>
          <th class="px-4 py-3 font-medium">Class</th>
          <th class="px-4 py-3 font-medium">Known stats</th>
          <th class="px-4 py-3 font-medium">Acquisition</th>
          <th class="px-4 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody>
        {
          VEHICLES.map((v) => (
            <tr class="border-b border-void-800 align-top last:border-0 hover:bg-void-900/40">
              <td class="px-4 py-3">
                {v.image && (
                  <img src={v.image} alt="" width="160" height="90" loading="lazy" decoding="async" class="mb-2 aspect-video w-36 rounded object-cover" />
                )}
                <div class="font-semibold text-void-100">
                  {v.hasDetailPage ? (
                    <a href={v.detailHref ?? `/vehicles/${v.slug}/`} class="text-plasma hover:underline">
                      {v.name}
                    </a>
                  ) : (
                    v.name
                  )}
                </div>
                <div class="mt-1 text-void-400">{v.summary}</div>
              </td>
              <td class="px-4 py-3 text-void-400">{v.class}</td>
              <td class="px-4 py-3 text-void-300">
                <ul class="list-inside list-disc space-y-1">
                  {v.knownStats.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </td>
              <td class="px-4 py-3 text-void-400">{v.acquisition}</td>
              <td class="px-4 py-3">
                <StatusBadge status={v.source.status} size="sm" />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-6 text-void-400">
    Class pages cover Kinetic Burst, Knife Edge, and why a ramjet cooks the craft. Pair them
    with the <a href="/tracks/" class="text-plasma hover:underline">planet list</a> before you
    lock a bike in for Sentinel One.
  </p>

  <p class="mt-4 text-void-400">
    Chasing the exclusive Kor Sarun landspeeder, speeder bike, and skim speeder? They ship with
    the Deluxe and Collector's editions — see our <a href="/editions/" class="text-plasma hover:underline">editions
    guide</a> for everything each version includes.
  </p>
</Layout>
