---
// 404 页 —— 引导用户回到主要分类，降低跳出。
import Layout from '../layouts/Layout.astro';
import { NAV } from '../data/site';

const title = 'Page not found — Star Wars Galactic Racer Wiki';
const description =
  'That page could not be found. Head back to the Star Wars Galactic Racer Wiki home or browse Characters, Vehicles, Tracks, and guides.';
---

<Layout title={title} description={description} noindex={true}>
  <section class="mx-auto max-w-2xl py-16 text-center">
    <p class="text-6xl font-bold text-plasma">404</p>
    <h1 class="mt-4 text-2xl font-bold text-void-100">This lane leads nowhere</h1>
    <p class="mt-3 text-void-400">
      The page you were looking for does not exist or has moved. Try one of these instead:
    </p>
    <ul class="mt-6 flex flex-wrap justify-center gap-3">
      <li>
        <a
          href="/"
          class="rounded-lg border border-void-700 bg-void-900 px-4 py-2 text-sm text-void-200 hover:border-plasma hover:text-plasma"
        >
          Home
        </a>
      </li>
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-lg border border-void-700 bg-void-900 px-4 py-2 text-sm text-void-200 hover:border-plasma hover:text-plasma"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
