---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';
const title = "Galactic Racer Characters and Campaign Roles";
const description = "Recognize Shade, Hibi, Kestar Bool and Darius Pax, then follow the campaign objective rather than a speculative unlock or character-stat table.";
const crumbs = [{name:'Home',url:'/'},{name:"Characters",url:'/characters/'}];
const guides = (await getCollection('guides', ({data}) => !data.draft && ["characters"].includes(data.category))).sort((a,b) => a.data.order-b.data.order || a.id.localeCompare(b.id));
---
<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
 <Breadcrumb items={crumbs} />
 <h1 class="mt-5 text-4xl font-bold">Characters and Campaign Roles</h1>
 <p class="mt-4 max-w-3xl text-lg text-void-300">Recognize Shade, Hibi, Kestar Bool and Darius Pax, then follow the campaign objective rather than a speculative unlock or character-stat table.</p>
 <ul class="mt-7 grid gap-5 md:grid-cols-2">{guides.map(g => <GuideCard href={`/${g.id}/`} title={g.data.heading ?? g.data.title} description={g.data.description} cover={g.data.cover ?? '/images/guide/night-stadium.webp'} label="Guide" verified={g.data.updatedAt} status={g.data.status} />)}</ul>
 <p class="mt-8 text-void-300">For campaign, control and technical guides, use the <a href="/guide/" class="text-plasma underline">complete guide directory</a>. Start with <a href="/game-modes/" class="text-plasma underline">mode selection</a> if you are unsure which activity fits your goal.</p>
</Layout>
