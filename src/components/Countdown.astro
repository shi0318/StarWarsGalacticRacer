---
// 发售倒计时 —— 首页 Hero 使用。
import { SITE, isReleased } from '../data/site';
import { formatReleaseDate } from '../utils/release-date.js';

const released = isReleased();
const releaseDate = formatReleaseDate(SITE.releaseDate);
---

{
  released ? (
    <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-300">
      <span class="h-2 w-2 rounded-full bg-emerald-400" />
      Out now — verified guides live
    </div>
  ) : (
    <div
      class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-void-300"
      data-countdown
      data-release={SITE.releaseDate}
    >
      <span class="text-void-400" data-countdown-prefix>Releases in</span>
      <span class="font-semibold text-plasma" data-countdown-value aria-live="polite">
        --
      </span>
      <span class="text-void-500"><span data-countdown-suffix>days</span> · <time datetime={SITE.releaseDate}>{releaseDate}</time></span>
    </div>
  )
}

<script>
  import { getReleaseState } from '../utils/release-date.js';

  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const out = el.querySelector<HTMLElement>('[data-countdown-value]');
    const prefix = el.querySelector<HTMLElement>('[data-countdown-prefix]');
    const suffix = el.querySelector<HTMLElement>('[data-countdown-suffix]');
    const tick = () => {
      const release = el.dataset.release;
      if (!release) return;
      const state = getReleaseState(release);
      if (state.kind === 'released') {
        if (prefix) prefix.textContent = '';
        if (out) out.textContent = 'Out now';
        if (suffix) suffix.textContent = '';
        return;
      }
      if (state.kind === 'today') {
        if (prefix) prefix.textContent = '';
        if (out) out.textContent = 'Launches today';
        if (suffix) suffix.textContent = '';
        return;
      }
      if (prefix) prefix.textContent = 'Releases in';
      if (out) out.textContent = String(state.days);
      if (suffix) suffix.textContent = state.days === 1 ? 'day' : 'days';
    };
    tick();
    setInterval(tick, 60000);
  }
</script>
