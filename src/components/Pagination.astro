---
interface Props { currentPage: number; totalPages: number; basePath: string; }
const { currentPage, totalPages, basePath } = Astro.props;
const base = basePath.endsWith('/') ? basePath : `${basePath}/`;
const hrefFor = (page: number) => (page === 1 ? base : `${base}page/${page}/`);
---
{totalPages > 1 && (<nav aria-label="Guide pages" class="mt-10 flex flex-wrap items-center justify-center gap-2">
  {currentPage > 1 && <a href={hrefFor(currentPage - 1)} rel="prev" class="rounded border border-void-700 px-4 py-2 text-sm text-void-300 hover:border-plasma/60 hover:text-plasma">Previous</a>}
  <ol class="flex flex-wrap items-center gap-2">{Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => <li>{page === currentPage ? <span aria-current="page" class="inline-flex min-w-9 justify-center rounded border border-plasma bg-plasma px-3 py-2 text-sm font-bold text-void-950">{page}</span> : <a href={hrefFor(page)} class="inline-flex min-w-9 justify-center rounded border border-void-700 px-3 py-2 text-sm text-void-300 hover:border-plasma/60 hover:text-plasma">{page}</a>}</li>)}</ol>
  {currentPage < totalPages && <a href={hrefFor(currentPage + 1)} rel="next" class="rounded border border-void-700 px-4 py-2 text-sm text-void-300 hover:border-plasma/60 hover:text-plasma">Next</a>}
</nav>)}
