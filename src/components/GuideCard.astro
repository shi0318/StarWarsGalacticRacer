---
import StatusBadge from './StatusBadge.astro';
import type { ConfidenceStatus } from '../data/sources';

interface Props { href: string; title: string; description: string; cover: string; label: string; verified: string; status: ConfidenceStatus; }
const { href, title, description, cover, label, verified, status } = Astro.props;
---
<li>
  <a href={href} class="group flex h-full flex-col overflow-hidden rounded-xl border border-void-800 bg-void-900/50 transition-colors hover:border-plasma/40 hover:bg-void-900">
    <div class="aspect-[16/10] overflow-hidden bg-void-950"><img src={cover} alt={`${title} cover`} width="640" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" /></div>
    <div class="flex flex-1 flex-col p-4">
      <div class="mb-2 flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-plasma/90"><span>{label}</span><span class="text-void-600">•</span><time datetime={verified}>{verified}</time></div>
      <div class="mb-2 flex items-start justify-between gap-2"><h2 class="text-base font-semibold leading-snug text-void-100 group-hover:text-plasma md:text-lg">{title}</h2><StatusBadge status={status} size="sm" /></div>
      <p class="line-clamp-3 flex-1 text-sm leading-relaxed text-void-400">{description}</p>
      <span class="mt-4 text-sm font-medium text-plasma/90 group-hover:text-plasma">Read guide →</span>
    </div>
  </a>
</li>
