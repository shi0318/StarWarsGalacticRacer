---
// JSON-LD 注入组件 —— 实现方案第三章 Schema 矩阵。
// 按页面类型传入不同 type，避免机械套用单一 Schema。
import { SITE } from '../data/site';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  // 页面类型，决定生成哪种 Schema
  type: 'home' | 'article' | 'news' | 'collection';
  // 当前页面绝对路径（含尾斜杠），用于 @id 与 url
  path: string;
  title?: string;
  description?: string;
  // 面包屑层级（article/news/collection 需要），须与用户实际看到的导航一致
  breadcrumb?: Crumb[];
  // Article/NewsArticle 的发布/更新时间
  datePublished?: string;
  dateModified?: string;
}

const { type, path, title, description, breadcrumb = [], datePublished, dateModified } = Astro.props;

const abs = (p: string) => new URL(p, SITE.url).href;
const pageUrl = abs(path);

// Organization —— 站点身份，被其他 Schema 以 @id 引用
const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url + '/',
  logo: {
    '@type': 'ImageObject',
    '@id': SITE.url + '/#logo',
    url: SITE.url + '/logo-512.png',
    width: 512,
    height: 512,
    caption: SITE.name,
  },
};

// BreadcrumbList —— 从传入层级生成
const breadcrumbList =
  breadcrumb.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${pageUrl}#breadcrumb`,
        itemListElement: breadcrumb.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: abs(c.url),
        })),
      }
    : null;

// 按页面类型组装 @graph
const graph: Record<string, unknown>[] = [];

if (type === 'home') {
  // 首页：WebSite + Organization，VideoGame 仅作辅助实体嵌入 about（不作独立顶层 Schema）
  graph.push(organization);
  graph.push({
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url + '/',
    description: SITE.description,
    publisher: { '@id': `${SITE.url}/#organization` },
    inLanguage: 'en',
    about: {
      // VideoGame 辅助实体：帮助 Google 理解游戏，不期待富结果
      '@type': 'VideoGame',
      name: 'Star Wars Galactic Racer',
      // 仅列官方确认的平台。官方 2026-04-30 预购公告明确 "coming to PC"，
      // 主机版本至今无任何第一方公告，因此不写入 Schema，避免向 Google 提交未确认事实。
      gamePlatform: ['PC', 'PlayStation 5', 'Xbox Series X|S'],
      applicationCategory: 'Game',
      author: { '@type': 'Organization', name: SITE.developer },
      publisher: { '@type': 'Organization', name: SITE.publisher },
      datePublished: SITE.releaseDate,
    },
  });
  graph.push({
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is Star Wars Galactic Racer any good?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Buy it if you want a combat tour where a shunt is legal and a wreck ends the run. Skip it if you want a long ranked career, a friend lobby, or a 20-course cup. Standard edition is $59.99 on Steam.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is Star Wars Galactic Racer a roguelike?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. It is runs-based. You pick events and cannot unpick them. Crash out too often and the tour ends, with only some perks carrying over. That is not a deck-building roguelike.',
        },
      },
      {
        '@type': 'Question',
        name: 'How long does it take to beat Star Wars Galactic Racer?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A first tour is an evening if you do not wreck out, and a weekend if you restart the same fragile bike. Arcade golds and the online tour are separate clocks.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does Star Wars Galactic Racer have a campaign?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. You play Shade, Hibi fits the speeder, and the tour climbs toward champion Kestar Bool. Arcade and online exist beside that campaign.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is Star Wars Galactic Racer on Switch 2 or Game Pass?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. It launched on PC, PlayStation 5, and Xbox Series X|S. It is not a Switch 2 game and it did not launch on Game Pass.',
        },
      },
    ],
  });
} else if (type === 'article' || type === 'news') {
  graph.push(organization);
  graph.push({
    '@type': type === 'news' ? 'NewsArticle' : 'Article',
    '@id': `${pageUrl}#article`,
    headline: title,
    description,
    inLanguage: 'en',
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    publisher: { '@id': `${SITE.url}/#organization` },
    ...(datePublished ? { datePublished } : {}),
    ...(dateModified ? { dateModified } : {}),
  });
  if (breadcrumbList) graph.push(breadcrumbList);
} else if (type === 'collection') {
  // 分类聚合页：CollectionPage + BreadcrumbList（不要标成 Article）
  graph.push(organization);
  graph.push({
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#collection`,
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
  });
  if (breadcrumbList) graph.push(breadcrumbList);
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
