---
// 站点页脚 —— 含独立粉丝站声明与素材来源说明（方案 1.2 合规声明）
import { SITE } from '../data/site';

const year = new Date().getFullYear();

const footerNav = [
  {
    title: 'Guides',
    links: [
      { label: 'All Characters', href: '/characters/' },
      { label: 'All Vehicles', href: '/vehicles/' },
      { label: 'All Tracks', href: '/tracks/' },
      { label: 'Unlock Guide', href: '/unlocks/' },
      { label: 'Full Guide', href: '/guide/' },
    ],
  },
  {
    title: 'Tips',
    links: [
      { label: 'Beginner Tips', href: '/tips/' },
      { label: 'Best Build', href: '/tips/best-build/' },
      { label: 'Credits Farming', href: '/tips/credits-farming/' },
      { label: 'Fastest Vehicle', href: '/tips/fastest-vehicle/' },
    ],
  },
  {
    title: 'Site',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Privacy Policy', href: '/privacy/' },
    ],
  },
];
---

<footer class="mt-20 border-t border-void-800 bg-void-900">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2 font-semibold text-void-100">
          <span class="text-plasma">✦</span>
          <span>Star Wars Galactic Racer Wiki</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-void-400">
          A verified, source-tracked wiki for Star Wars Galactic Racer. Every fact carries a
          confirmation status and a source.
        </p>
      </div>

      {
        footerNav.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-void-300">
              {col.title}
            </h2>
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-void-400 transition-colors hover:text-plasma"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- 合规声明区（方案 1.2） -->
    <div class="mt-10 space-y-3 border-t border-void-800 pt-6 text-xs leading-relaxed text-void-500">
      <p>
        <strong class="text-void-400">Independent fan site.</strong> This is an independent fan
        site. Not affiliated with or endorsed by {SITE.developer}, {SITE.publisher}, Lucasfilm,
        or The Walt Disney Company. Star Wars and all related trademarks are the property of
        Lucasfilm Ltd. / their respective owners.
      </p>
      <p>
        <strong class="text-void-400">Sources &amp; imagery.</strong> Images are official Steam
        screenshots and key art, credited to their source and used for commentary and reference.
        Every page notes the source and confirmation status of its information. To request removal
        of any content, see our{' '}
        <a href="/contact/" class="underline hover:text-void-300">contact page</a>.
      </p>
      <p class="pt-2 text-void-600">
        &copy; {year} {SITE.name}. Content licensed for personal use.
      </p>
    </div>
  </div>
</footer>
