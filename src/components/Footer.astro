---
// 站点页脚 —— 含独立粉丝站声明与素材来源说明（方案 1.2 合规声明）
import { SITE } from '../data/site';

const year = new Date().getFullYear();

const footerNav = [
  {
    title: 'Guides',
    links: [
      { label: 'Game overview', href: '/game-overview/' },
      { label: 'Characters', href: '/characters/' },
      { label: 'Vehicles', href: '/vehicles/' },
      { label: 'Tracks', href: '/tracks/' },
      { label: 'Full Guide', href: '/guide/' },
    ],
  },
  {
    title: 'Tips',
    links: [
      { label: 'Beginner Tips', href: '/tips/' },
      { label: 'First campaign tour', href: '/tips/galactic-racer-first-tour-plan/' },
      { label: 'Combat racing', href: '/tips/shunt-takedown/' },
      { label: 'PC requirements', href: '/pc-requirements/' },
    ],
  },
  {
    title: 'Site',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Privacy Policy', href: '/privacy/' },
      { label: 'Terms of Use', href: '/terms/' },
      { label: 'Editorial Policy', href: '/editorial/' },
    ],
  },
];
---

<footer class="mt-20 border-t border-void-800 bg-void-900">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2 font-semibold text-void-100">
          <span class="text-plasma">✦</span>
          <span>Star Wars Galactic Racer Guide</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-void-400">
          A post-launch guide for Star Wars Galactic Racer. Racers, vehicles, planets, and the
          builds that survive them.
        </p>
      </div>

      {
        footerNav.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-void-300">
              {col.title}
            </h2>
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-void-400 transition-colors hover:text-plasma"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- 合规声明区（方案 1.2） -->
    <div class="mt-10 space-y-3 border-t border-void-800 pt-6 text-xs leading-relaxed text-void-500">
      <p>
        <strong class="text-void-400">Unofficial fan guide. Not affiliated with Lucasfilm, Disney, Fuse Games or Secret Mode.</strong>
        Star Wars and all related trademarks belong to their respective owners.
      </p>
      <p>
        <strong class="text-void-400">Imagery.</strong> Screenshots are used for commentary on
        the circuits and vehicles. To request removal of any content, see our{' '}
        <a href="/contact/" class="underline hover:text-void-300">contact page</a>.
      </p>
      <p class="pt-2 text-void-600">
        &copy; {year} {SITE.name}. Original site text; game imagery and trademarks remain with their owners.
      </p>
    </div>
  </div>
</footer>
