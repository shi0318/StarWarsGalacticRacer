---
// 站点头部导航 —— 与 NAV 常量保持一致（方案 3.2：导航层级与 Breadcrumb 一致）
import { NAV } from '../data/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-void-800 bg-void-950/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3" aria-label="Primary">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-void-100">
      <span class="text-plasma">✦</span>
      <span>Galactic Racer <span class="text-void-400">Guide</span></span>
    </a>

    <!-- 桌面导航 -->
    <ul class="hidden flex-wrap items-center justify-end gap-1 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded px-2.5 py-2 text-sm transition-colors',
                isActive(item.href)
                  ? 'text-plasma'
                  : 'text-void-300 hover:text-void-100 hover:bg-void-800',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- 移动端：details/summary 纯 CSS 折叠菜单，无需 JS -->
    <details class="relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center rounded p-2 text-void-200 hover:bg-void-800"
        aria-label="Open menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-48 rounded-lg border border-void-700 bg-void-900 p-2 shadow-xl">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded px-3 py-2 text-sm',
                  isActive(item.href)
                    ? 'text-plasma'
                    : 'text-void-300 hover:bg-void-800 hover:text-void-100',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
